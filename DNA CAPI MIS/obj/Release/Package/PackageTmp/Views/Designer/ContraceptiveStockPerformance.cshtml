

@{
    ViewBag.Title = "Dashboard";
}
@section Scripts {
    <script>
        var viewURL = "/Designer/Dashboard/";
    </script>

}

<link href="~/Content/DSDS/dsds.css" rel="stylesheet" type="text/css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css">
@*CSS Class desktop is used for overlay*@
<style>
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th, td {
        border: 1px solid black;
        padding: 5px;
        text-align: center;
    }

 
</style>
<style>
    .model {
        display: none;
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.5);
    }

    .model-content {
        background-color: #fefefe;
        margin: 10% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
    }

    .close {
        color: #aaaaaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: #000;
            text-decoration: none;
            cursor: pointer;
        }
</style>
<style>
    .optionsRadios {
        padding-right: 15px;
        padding-left: 15px;
    }

    table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;
    }

    td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }

    tr:nth-child(even) {
        background-color: #dddddd;
    }
</style>


<style>
    /* Style for the table */
    .table {
        width: 100%;
        border-collapse: collapse;
    }
    /* Style for table headers */
    th {
        background-color: #007bff; /* Blue header color */
        color: #fff; /* Text color */
        font-weight: bold;
        text-align: left;
    }
    /* Style for table cells */
    td {
        border: 1px solid #dddddd; /* Border color for cells */
        padding: 8px;
    }
    /* Alternate row color */
    tr:nth-child(even) {
        background-color: #f2f2f2; /* Light gray */
    }
</style>
<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
    }

    .container {
        max-width: 600px;
        margin: 20px auto;
        padding: 20px;
        background-color: #fff;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
    }

    ul {
        list-style-type: none;
        padding-left: 0;
    }

    li {
        margin-bottom: 20px;
    }

    .criteria {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

        .criteria label {
            font-weight: bold;
        }

        .criteria select {
            padding: 5px;
            width: 180px;
        }

        .criteria .sufficient {
            color: green;
        }

        .criteria .quite-sufficient {
            color: orange;
        }

        .criteria .poor {
            color: red;
        }
</style>
<div class="row desktop">
    <div class="col-xs-12">

        @Html.Partial("_ReportPartial")



        <div class="col-12" style="text-align:center;">
          
            <div class="col-12" style="overflow:auto">

                <table id="grid">
              
                    <thead>

                        <tr>
                            <th style="text-align: center" class="header" colspan="34"> Contraceptive Stock Performance
</tr>

                        <tr>
                            <th style="text-align: center" class="header" colspan="34">Summary Report of Contraceptive Stock Performance of SDPs Visits During  <span id="Start"> </span>  to <span id="End">  </span> in District <span id="disP"></span></th>
                        </tr>

                        <tr class="header-row">
                            <th colspan="2"></th>
                            <th colspan="2"></th>

                            <th colspan="3">Last 3 Months Contraceptive Performance</th>
                            <th colspan="3">Condoms</th>
                            <th colspan="3">Oral Pills (POP)</th>
                            <th colspan="3">OP (COC)</th>
                            <th colspan="3">OP (ECP)</th>
                            <th colspan="3">3 months Inj-Depo</th>
                            @*<th colspan="3">Syana Press</th>*@
                            <th colspan="3">IUCD (CT-380-A)</th>
                            <th colspan="3">Jadelle</th>
                            <th colspan="3">Tubaligation (TL)</th>
                            <th colspan="3">NSV</th>
                        </tr>
                        <tr>
                            <th>Date</th>
                            <th>District</th>
                            <th>SDP Type</th>
                            <th>SDP Name</th>
                            <th>1st</th>
                            <th>2nd</th>
                            <th>3rd</th>
                            <th>1st</th>
                            <th>2nd</th>
                            <th>3rd</th>
                            <th>1st</th>
                            <th>2nd</th>
                            <th>3rd</th>
                            <th>1st</th>
                            <th>2nd</th>
                            <th>3rd</th>
                            <th>1st</th>
                            <th>2nd</th>
                            <th>3rd</th>
                            <th>1st</th>
                            <th>2nd</th>
                            <th>3rd</th>
                            <th>1st</th>
                            <th>2nd</th>
                            <th>3rd</th>
                            <th>1st</th>
                            <th>2nd</th>
                            <th>3rd</th>
                            <th>1st</th>
                            <th>2nd</th>
                            <th>3rd</th>
                            <th>1st</th>
                            <th>2nd</th>
                            <th>3rd</th>
                            @*<th>1st</th>
            <th>2nd</th>
            <th>3rd</th>*@
                        </tr>
                    </thead>


                    <tbody id="grid8">
                    </tbody>
                </table>


            </div>
        </div>

        <button id="exportButton">Download as Excel</button>
        <!-- Loading (remove the following to stop the loading)-->
        <div class="overlay" style="display:none;"></div>
        <div class="loading-img" style="display: none;"></div>
        <!-- end loading -->





    </div>


    <script src="https://cdn.datatables.net/2.0.5/js/dataTables.min.js"></script>


    <script>


        $(document).ready(function () {
            grid8("0")
        });

        var selectedTex = "";
        $('#Checklist').change(function () {
            var Checklist = $('#Checklist').val();

            GetDistrict(Checklist);
            $("#District").empty();
            $("#Center").empty();
        });

        function grid8(Filter) {
            $.ajax({
                type: 'POST',
                url: "/Designer/Grid8/" + Filter,
                data: {},
                async: true,
                success: function (data) {
                    $("#grid8").empty();
                    var html = '';
                    $.each(data, function (key, item) {

                        var ConStockPosition = item.ConStockPosition.split('|');

                        var Mon1_1 = ConStockPosition[0].split('-')[1].split(',')[0];
                        var Mon1_2 = ConStockPosition[0].split('-')[1].split(',')[1];
                        var Mon1_3 = ConStockPosition[0].split('-')[1].split(',')[2];

                        var Mon2_1 = ConStockPosition[1].split('-')[1].split(',')[0];
                        var Mon2_2 = ConStockPosition[1].split('-')[1].split(',')[1];
                        var Mon2_3 = ConStockPosition[1].split('-')[1].split(',')[2];

                        var Mon3_1 = ConStockPosition[2].split('-')[1].split(',')[0];
                        var Mon3_2 = ConStockPosition[2].split('-')[1].split(',')[1];
                        var Mon3_3 = ConStockPosition[2].split('-')[1].split(',')[2];


                        var Mon4_1 = ConStockPosition[3].split('-')[1].split(',')[0];
                        var Mon4_2 = ConStockPosition[3].split('-')[1].split(',')[1];
                        var Mon4_3 = ConStockPosition[3].split('-')[1].split(',')[2];


                        var Mon5_1 = ConStockPosition[4].split('-')[1].split(',')[0];
                        var Mon5_2 = ConStockPosition[4].split('-')[1].split(',')[1];
                        var Mon5_3 = ConStockPosition[4].split('-')[1].split(',')[2];



                        var Mon6_1 = ConStockPosition[5].split('-')[1].split(',')[0];
                        var Mon6_2 = ConStockPosition[5].split('-')[1].split(',')[1];
                        var Mon6_3 = ConStockPosition[5].split('-')[1].split(',')[2];



                        var Mon7_1 = ConStockPosition[6].split('-')[1].split(',')[0];
                        var Mon7_2 = ConStockPosition[6].split('-')[1].split(',')[1];
                        var Mon7_3 = ConStockPosition[6].split('-')[1].split(',')[2];


                        var Mon8_1 = ConStockPosition[7].split('-')[1].split(',')[0];
                        var Mon8_2 = ConStockPosition[7].split('-')[1].split(',')[1];
                        var Mon8_3 = ConStockPosition[7].split('-')[1].split(',')[2];


                        var Mon9_1 = ConStockPosition[8].split('-')[1].split(',')[0];
                        var Mon9_2 = ConStockPosition[8].split('-')[1].split(',')[1];
                        var Mon9_3 = ConStockPosition[8].split('-')[1].split(',')[2];

                        var Mon10_1 = ConStockPosition[9].split('-')[1].split(',')[0];
                        var Mon10_2 = ConStockPosition[9].split('-')[1].split(',')[1];
                        var Mon10_3 = ConStockPosition[9].split('-')[1].split(',')[2];


                        html += '<tr>';
                        html += '<td>' + item.asDate + '</td>';
                        html += '<td>' + item.District + '</td>';
                        html += '<td>' + item.ProjectName + '</td>';
                        html += '<td>' + item.Center + '</td>';


                        html += '<td>' + Mon1_1 + '</td>';
                        html += '<td>' + Mon1_2 + '</td>';
                        html += '<td>' + Mon1_3 + '</td>';

                        html += '<td>' + Mon2_1 + '</td>';
                        html += '<td>' + Mon2_2 + '</td>';
                        html += '<td>' + Mon2_3 + '</td>';

                        html += '<td>' + Mon3_1 + '</td>';
                        html += '<td>' + Mon3_2 + '</td>';
                        html += '<td>' + Mon3_3 + '</td>';

                        html += '<td>' + Mon4_1 + '</td>';
                        html += '<td>' + Mon4_2 + '</td>';
                        html += '<td>' + Mon4_3 + '</td>';

                        html += '<td>' + Mon5_1 + '</td>';
                        html += '<td>' + Mon5_2 + '</td>';
                        html += '<td>' + (Mon5_3 == undefined ? "0" : Mon5_3) + '</td>';

                        html += '<td>' + Mon6_1 + '</td>';
                        html += '<td>' + Mon6_2 + '</td>';
                        html += '<td>' + Mon6_3 + '</td>';



                        html += '<td>' + Mon7_1 + '</td>';
                        html += '<td>' + Mon7_2 + '</td>';
                        html += '<td>' + Mon7_3 + '</td>';
                    


                        html += '<td>' + Mon8_1 + '</td>';
                        html += '<td>' + Mon8_2 + '</td>';
                        html += '<td>' + Mon8_3 + '</td>';


                        html += '<td>' + Mon9_1 + '</td>';
                        html += '<td>' + Mon9_2 + '</td>';
                        html += '<td>' + Mon9_3 + '</td>';

                        html += '<td>' + Mon10_1 + '</td>';
                        html += '<td>' + Mon10_2 + '</td>';
                        html += '<td>' + Mon10_3 + '</td>';

                        html += '</tr>';
                    });
                    $('#grid8').html(html);

                }


            });

        }


        $('#Search').click(function () {

            var startDate = $("#startDate").val();
            var endDate = $("#endDate").val();

            if (startDate == "") {
                startDate = "01-01-1950";
            }
            if (endDate == "") {
                endDate = "01-01-2099";
            }

            var Project = $('#Checklist').val();

            if (District == "") {
                District = "0";
            }
            if (Center == "") {
                Center = "0";
            }

            if (Project == "") {
                Project = "0,0,0";
            }

            try {
                var District = $('#District').find('option:selected').text();
                var Center = $('#Center').find('option:selected').text();


                $('#Start').text(startDate);
                $('#End').text(endDate);
                $('#disP').text(District);

                var Filter = Project + "," + District + "," + Center + "," + startDate + "," + endDate;

                try {
                    grid8(Filter);
                }
                catch (ex) {

                }

            }
            catch (ex) {

            }

        });
    </script>

