                                var Gas = EGV[1];
                                var Water = EGV[2];


                                if (Electric == "1") {
                                    Electric = "Yes"
                                }
                                else {
                                    Electric = "No"
                                }

                                if (Gas == "1") {
                                    Gas = "Yes"
                                }
                                else {
                                    Gas = "No"
                                }

