                try {
                    var CSP = data.Field.StockOfCon.split('|');

                    function isValidDate(d) {
                        const parsed = Date.parse(d);
                        if (isNaN(parsed)) return false;

                        // Check if the date string starts with 1900 (e.g., 1900-01-01)
                        if (d.startsWith("1900")) return false;

                        return true;
                    }

                    for (var i = 0; i < CSP.length; i++) {
                        var splitParts = CSP[i].split(',');

                        if (splitParts.length !== 2) {
                            $('#CSPS' + i).text(0);
                            $('#CSPE' + i).text('');
                            continue;
                        }

                        // Extract values
                        var leftPart = splitParts[0].substring(splitParts[0].indexOf('-') + 1).trim();
                        var rightPart = splitParts[1].trim();

                        if (isValidDate(leftPart) && !isNaN(rightPart)) {
                            $('#CSPS' + i).text(rightPart);    // stock
                            $('#CSPE' + i).text(leftPart);     // expiry
                        } else if (!isNaN(leftPart) && isValidDate(rightPart)) {
                            $('#CSPS' + i).text(leftPart);     // stock
                            $('#CSPE' + i).text(rightPart);    // expiry
                        } else {
