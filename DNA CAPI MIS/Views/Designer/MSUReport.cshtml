    // Function to add status badges
    function addStatusBadges() {
        // Add badges to Yes/No statuses
        $('td').each(function() {
            var text = $(this).text().trim();
            if (text === 'Yes') {
                $(this).html('<span class="status-badge status-yes">Yes</span>');
            } else if (text === 'No') {
                $(this).html('<span class="status-badge status-no">No</span>');
            } else if (text === 'Present') {
                $(this).html('<span class="status-badge status-present">Present</span>');
            } else if (text === 'Absent') {
                $(this).html('<span class="status-badge status-absent">Absent</span>');
            } else if (text === 'Good') {
                $(this).html('<span class="status-badge status-good">Good</span>');
            } else if (text === 'Satisfactory') {
                $(this).html('<span class="status-badge status-satisfactory">Satisfactory</span>');
            } else if (text === 'Poor') {
                $(this).html('<span class="status-badge status-poor">Poor</span>');
            } else if (text === 'Available') {
                $(this).html('<span class="status-badge status-yes">Available</span>');
            } else if (text === 'Not Available') {
                $(this).html('<span class="status-badge status-no">Not Available</span>');
            }
        });
    }

    // Enhanced print function
    $('#downloadPDFBtn').click(function () {
        $('#downloadPDFBtn').hide();

        // Add status badges before printing
        addStatusBadges();

        // Small delay to ensure badges are rendered
        setTimeout(function() {
            window.print();
            $('#downloadPDFBtn').show();
        }, 100);
    });

    // Add status badges when data is loaded
    $(document).ready(function() {
        // Show loader initially
        $('#loader').show();
        
        // Add badges after a short delay to ensure data is loaded
        setTimeout(function() {
            addStatusBadges();
            // Hide loader after data is processed
            $('#loader').fadeOut(500);
        }, 1000);
    });


</script>