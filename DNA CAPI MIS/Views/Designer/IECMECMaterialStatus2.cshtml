

@{
    ViewBag.Title = "Dashboard";
}
@section Scripts {
    <script>
        var viewURL = "/Designer/Dashboard/";
    </script>

}

<link href="~/Content/DSDS/dsds.css" rel="stylesheet" type="text/css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css">
@*CSS Class desktop is used for overlay*@

<style>
    .model {
        display: none;
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.5);
    }

    .model-content {
        background-color: #fefefe;
        margin: 10% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
    }

    .close {
        color: #aaaaaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: #000;
            text-decoration: none;
            cursor: pointer;
        }
</style>
<style>
    .optionsRadios {
        padding-right: 15px;
        padding-left: 15px;
    }

    table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;
    }

    td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }

    tr:nth-child(even) {
        background-color: #dddddd;
    }
</style>


<style>
    /* Style for the table */
    .table {
        width: 100%;
        border-collapse: collapse;
    }
    /* Style for table headers */
    th {
        background-color: #007bff; /* Blue header color */
        color: #fff; /* Text color */
        font-weight: bold;
        text-align: left;
    }
    /* Style for table cells */
    td {
        border: 1px solid #dddddd; /* Border color for cells */
        padding: 8px;
    }
    /* Alternate row color */
    tr:nth-child(even) {
        background-color: #f2f2f2; /* Light gray */
    }
</style>
<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
    }

    .container {
        max-width: 600px;
        margin: 20px auto;
        padding: 20px;
        background-color: #fff;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
    }

    ul {
        list-style-type: none;
        padding-left: 0;
    }

    li {
        margin-bottom: 20px;
    }

    .criteria {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

        .criteria label {
            font-weight: bold;
        }

        .criteria select {
            padding: 5px;
            width: 180px;
        }

        .criteria .sufficient {
            color: green;
        }

        .criteria .quite-sufficient {
            color: orange;
        }

        .criteria .poor {
            color: red;
        }
</style>
<div class="row desktop">
    <div class="col-xs-12">

        @Html.Partial("_ReportPartial")



        <div class="col-12" style="text-align:center;">
        
            <div class="col-10" style="overflow:auto">

                <table id="grid" >
                    <thead>
                        <tr>
                            <th style="text-align: center" class="header" colspan="22">IEC & MEC Material Status
</tr>

                        <tr>
                            <th style="text-align: center" class="header" colspan="22">Summary Report of IEC & MEC Material Status of SDPs Visits During  <span id="Start"> </span>  to <span id="End">  </span> in District <span id="disP"></span></th>
                        </tr>
                        <tr>
                            <th>Date</th>
                            <th>District</th>
                            <th>SDP Type</th>
                            <th>SDP Name</th>
                            <th colspan="3">Daily Client Register/ECR</th>
                            <th colspan="3">Daily #/Monthly Break-Up</th>
                            <th colspan="3">Medicine Stock Register</th>
                            <th colspan="3">Contraceptive Stock Register</th>
                            <th colspan="3">Log Book</th>
                            <th colspan="3">Dead Stock Register</th>
                        </tr>
                        <tr>
                            <th colspan="4"></th>
                            <th>Available</th>
                            <th>Maintained</th>
                            <th>Proper</th>
                            <th>Available</th>
                            <th>Maintained</th>
                            <th>Proper</th>
                            <th>Available</th>
                            <th>Maintained</th>
                            <th>Proper</th>
                            <th>Available</th>
                            <th>Maintained</th>
                            <th>Proper</th>
                            <th>Available</th>
                            <th>Maintained</th>
                            <th>Proper</th>
                            <th>Available</th>
                            <th>Maintained</th>
                            <th>Proper</th>
                        </tr>
                    </thead>
                    <tbody id="Grid9">
                        
                    </tbody>
                </table>

            </div>
        </div>

        <button id="exportButton">Download as Excel</button>
        <!-- Loading (remove the following to stop the loading)-->
        <div class="overlay" style="display:none;"></div>
        <div class="loading-img" style="display: none;"></div>
        <!-- end loading -->





    </div>


            <script src="https://cdn.datatables.net/2.0.5/js/dataTables.min.js"></script>


            <script>


                $(document).ready(function () {
                    GridIECandStock("0")
                });

                var selectedTex = "";
                $('#Checklist').change(function () {
                    var Checklist = $('#Checklist').val();

                    GetDistrict(Checklist);
                    $("#District").empty();
                    $("#Center").empty();

                  
                    


                });


                function GridIECandStock(Filter) {

                    $.ajax({
                        type: 'POST',
                        url: "/Designer/GridIECandStock/" + Filter,
                        data: {},
                        async: true,
                        success: function (data) {
                            $("#Grid9").empty();
                            var html = '';
                            $.each(data, function (key, item) {


                                var DC = item.dailyClient.split(",");
                                var DC1 = DC[0];
                                var DC2 = DC[1];
                                var DC3 = DC[2];



                                var MS = item.MediStock.split(",");
                                var MS1 = MS[0];
                                var MS2 = MS[1];
                                var MS3 = MS[2];
                                
                                var BU = item.BreakUp.split(",");
                                var BU1 = BU[0];
                                var BU2 = BU[1];
                                var BU3 = BU[2];

                                var SR = item.StockReg.split(",");
                                var SR1 = SR[0];
                                var SR2 = SR[1];
                                var SR3 = SR[2];

                                var LB = item.LogBook.split(",");
                                var LB1 = LB[0];
                                var LB2 = LB[1];
                                var LB3 = LB[2];

                                var DS = item.DeadStock.split(",");
                                var DS1 = DS[0];
                                var DS2 = DS[1];
                                var DS3 = DS[2];


                                html += '<tr>';
                                html += '<td>' + item.asDate + '</td>';
                                html += '<td>' + item.District + '</td>';
                                html += '<td>' + item.ProjectName + '</td>';
                                html += '<td>' + item.Center + '</td>';

                                html += '<td>' + (DC1 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (DC2 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (DC3 == "1" ? "Yes" : "No") + '</td>';


                                html += '<td>' + (MS1 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (MS2 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (MS3 == "1" ? "Yes" : "No") + '</td>';


                                html += '<td>' + (BU1 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (BU2 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (BU3 == "1" ? "Yes" : "No") + '</td>';

                                html += '<td>' + (SR1 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (SR2 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (SR3 == "1" ? "Yes" : "No") + '</td>';

                                html += '<td>' + (LB1 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (LB2 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (LB3 == "1" ? "Yes" : "No") + '</td>';

                                html += '<td>' + (DS1 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (DS2 == "1" ? "Yes" : "No") + '</td>';
                                html += '<td>' + (DS3 == "1" ? "Yes" : "No") + '</td>';

                                html += '</tr>';
                            });
                            $('#Grid9').html(html);

                        }


                    });

                }

                $('#Search').click(function () {

                    var startDate = $("#startDate").val();
                    var endDate = $("#endDate").val();

                    if (startDate == "") {
                        startDate = "01-01-1950";
                    }
                    if (endDate == "") {
                        endDate = "01-01-2099";
                    }

                    var Project = $('#Checklist').val();

                    if (District == "") {
                        District = "0";
                    }
                    if (Center == "") {
                        Center = "0";
                    }

                    if (Project == "") {
                        Project = "0,0,0";
                    }

                    try {
                        var District = $('#District').find('option:selected').text();
                        var Center = $('#Center').find('option:selected').text();

                        $('#Start').text(startDate);
                        $('#End').text(endDate);
                        $('#disP').text(District);

                        var Filter = Project + "," + District + "," + Center + "," + startDate + "," + endDate;

                        try {
                            GridIECandStock(Filter);
                        }
                        catch (ex) {

                        }

                    }
                    catch (ex) {

                    }

                });


            </script>

