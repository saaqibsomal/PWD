        <!-- end loading -->





    </div>


            <script src="https://cdn.datatables.net/2.0.5/js/dataTables.min.js"></script>


            <script>


                $(document).ready(function () {
                 Grid3("0");
                });

                var selectedTex = "";
                $('#Checklist').change(function () {
                    var Checklist = $('#Checklist').val();

                    GetDistrict(Checklist);
                    $("#District").empty();
                    $("#Center").empty();

                  
                    


                });

 function Grid3(Filter) {




                    $.ajax({
                        type: 'POST',
                        url: "/Designer/Grid3/" + Filter,
                        data: {},
                        async: true,
                        success: function (data) {
                            $("#tbody3").empty();
                            var html = '';
                            $.each(data, function (key, item) {

                                var EGV = item.StatusOfBuilding.split(",");
                                var Electric = EGV[0];
                                var Gas = EGV[1];
                                var Water = EGV[2];


                                if (Electric == "1") {
                                    Electric = "Yes"
                                }
                                else {
                                    Electric = "No"
                                }

                                if (Gas == "1") {
                                    Gas = "Yes"
                                }
                                else {
                                    Gas = "No"
                                }

                                if (Water == "1") {
                                    Water = "Yes"
                                }
                                else {
                                    Water = "No"
                                }


                                var IPM = item.IndicateSign.split(",");
                                var Installed = IPM[0];
                                var Proper = IPM[1];
                                var Maintained = IPM[2];


                                if (Installed == "1") {
                                    Installed = "Yes"
                                }
                                else {
                                    Installed = "No"
                                }

                                if (Proper == "1") {
                                    Proper = "Yes"
                                }
                                else {
                                    Proper = "No"
                                }

                                if (Maintained == "1") {
                                    Maintained = "Yes"
                                }
                                else {
                                    Maintained = "No"
                                }

                                //1-Installed
                                //2-Proper
                                //3-Maintained

                                html += '<tr>';
                                html += '<td>' + item.asDate + '</td>';
                                html += '<td>' + item.District + '</td>';
                                html += '<td>' + item.ProjectName + '</td>';
                                html += '<td>' + item.Center + '</td>';

                                html += '<td>' + Installed + '</td>';
                                html += '<td>' + Proper + '</td>';
                                html += '<td>' + Maintained + '</td>';

                                html += '<td>' + Electric + '</td>';
                                html += '<td>' + Gas + '</td>';
                                html += '<td>' + Water + '</td>';

                                html += '<td>' + item.Cleanliness + '</td>';
                                html += '</tr>';
                            });
                            $('#tbody3').html(html);

                        }


                    });

                }


                $('#Search').click(function () {

                    var startDate = $("#startDate").val();
                    var endDate = $("#endDate").val();

                    if (startDate == "") {
                        startDate = "01-01-1950";
                    }
                    if (endDate == "") {
                        endDate = "01-01-2099";
                    }

                    var Project = $('#Checklist').val();

                    if (District == "") {
                        District = "0";
                    }
                    if (Center == "") {
                        Center = "0";
                    }

                    if (Project == "") {
                        Project = "0,0,0";
                    }

                    try {
                        var District = $('#District').find('option:selected').text();
                        var Center = $('#Center').find('option:selected').text();
                        $('#Start').text(startDate);
                        $('#End').text(endDate);
                        $('#disP').text(District);
                        var Filter = Project + "," + District + "," + Center + "," + startDate + "," + endDate;

                        try {
                            Grid3(Filter);
                        }
                        catch (ex) {

                        }

                    }
                    catch (ex) {

                    }

                });

            </script>

